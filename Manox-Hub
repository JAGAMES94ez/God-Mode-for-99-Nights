--// Script local seguro: God Mode flutuante com movimento ativo
--// Uso educativo no Roblox Studio

-- Serviços
local Players = game:GetService("Players")
local player = Players.LocalPlayer
local character = player.Character or player.CharacterAdded:Wait()
local humanoid = character:WaitForChild("Humanoid")

-- Interface
local gui = Instance.new("ScreenGui")
gui.Name = "GodModeUI"
gui.ResetOnSpawn = false
gui.Parent = player:WaitForChild("PlayerGui")

-- Botão flutuante
local button = Instance.new("TextButton")
button.Size = UDim2.new(0, 160, 0, 45)
button.Position = UDim2.new(0.5, -80, 0.8, 0)
button.BackgroundColor3 = Color3.fromRGB(0, 170, 255)
button.TextColor3 = Color3.new(1, 1, 1)
button.Text = "God Mode"
button.Font = Enum.Font.GothamBold
button.TextSize = 18
button.Parent = gui

-- Cantos arredondados
local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0, 14)
corner.Parent = button

-- Sombra
local shadow = Instance.new("UIStroke")
shadow.Thickness = 2
shadow.Color = Color3.fromRGB(255, 255, 255)
shadow.Transparency = 0.3
shadow.Parent = button

-- Flutuação suave
task.spawn(function()
	local dir = 1
	while task.wait(0.05) do
		local pos = button.Position
		button.Position = pos + UDim2.new(0, 0, 0, dir)
		if pos.Y.Offset > 5 then dir = -1 end
		if pos.Y.Offset < -5 then dir = 1 end
	end
end)

-- Estado
local godModeAtivo = false
local glow

-- Funções
local function ativarGodMode()
	godModeAtivo = true
	button.BackgroundColor3 = Color3.fromRGB(0, 255, 100)
	button.Text = "God Mode: ON"

	-- Efeito visual
	glow = Instance.new("ParticleEmitter")
	glow.LightEmission = 1
	glow.Texture = "rbxassetid://258128463" -- brilho branco suave
	glow.Size = NumberSequence.new(0.6)
	glow.Lifetime = NumberRange.new(1)
	glow.Rate = 10
	glow.Speed = NumberRange.new(0)
	glow.Parent = character:WaitForChild("HumanoidRootPart")

	-- Mantém o jogador vivo
	task.spawn(function()
		while godModeAtivo and humanoid do
			humanoid.Health = humanoid.MaxHealth
			task.wait(0.1)
		end
	end)

	-- Bloqueia dano externo
	humanoid:GetPropertyChangedSignal("Health"):Connect(function()
		if godModeAtivo and humanoid.Health < humanoid.MaxHealth then
			humanoid.Health = humanoid.MaxHealth
		end
	end)
end

local function desativarGodMode()
	godModeAtivo = false
	button.BackgroundColor3 = Color3.fromRGB(0, 170, 255)
	button.Text = "God Mode: OFF"
	if glow then
		glow.Enabled = false
		glow:Destroy()
	end
end

